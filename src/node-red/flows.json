    {
        "id": "c7a1000000000001",
        "type": "function",
        "z": "1b67ba1108d15729",
        "name": "ordre STOP",
        "func": "// Etape 17 : construit l'ordre de mise en veille et le publie\n// sur le topic de downlink de ChirpStack (broker Mosquitto local).\n\n// Anti-rebond : avec ChirpStack, chaque publication AJOUTE un downlink\n// a la file d'attente (pas de \"replace\"). On ignore donc les clics\n// rapproches, ce qui limite aussi le temps d'emission (duty cycle 1 %).\nvar maintenant = Date.now();\nvar dernier = context.get(\"dernierEnvoi\") || 0;\nif (maintenant - dernier < 300000) {\n    node.warn(\"STOP ignore : deja envoye il y a moins de 5 minutes\");\n    return null;\n}\ncontext.set(\"dernierEnvoi\", maintenant);\n\nvar APP_ID = \"272fc846-0568-494e-87c2-46ef135e8d59\";   // UUID de l'application ChirpStack\nvar DEV_EUI = \"70b3d5499bd6a27c\";                       // en minuscules dans les topics\nmsg.topic = \"application/\" + APP_ID + \"/device/\" + DEV_EUI + \"/command/down\";\n\n// L'ordre part en clair : le codec du profil de device (encodeDownlink)\n// le transforme en un seul octet, 0x01.\nmsg.payload = {\n    devEui: DEV_EUI,\n    confirmed: false,\n    fPort: 1,\n    object: { commande: \"stop\" }\n};\n\nnode.status({ fill: \"blue\", shape: \"dot\", text: \"STOP envoye a \" + new Date().toLocaleTimeString(\"fr-FR\") });\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,
        "y": 720,
        "wires": [
            [
                "c7a1000000000002"
            ]
        ]
    },
