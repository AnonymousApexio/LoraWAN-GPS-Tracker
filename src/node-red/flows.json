    {
        "id": "c7a1000000000004",
        "type": "function",
        "z": "1b67ba1108d15729",
        "name": "etat du downlink",
        "func": "var evt = msg.topic.split(\"/\").pop();\nvar heure = new Date().toLocaleTimeString(\"fr-FR\");\nif (evt === \"txack\") {\n    msg.payload = heure + \" - downlink envoye au FiPy par la passerelle\";\n} else if (evt === \"log\") {\n    msg.payload = heure + \" - LNS : \" + msg.payload.code + \" \" + (msg.payload.description || \"\");\n} else {\n    return null;   // up, join, status... : traites ailleurs\n}\nnode.status({ fill: evt === \"log\" ? \"red\" : \"green\", shape: \"dot\", text: heure + \" \" + evt });\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 430,
        "y": 1080,
        "wires": [
            [
                "c7a1000000000005"
            ]
        ]
    },
